{
  "name": "greenlint",
  "displayName": "greenlint",
  "description": "Flags energy-wasteful code and config patterns as you type, with the reason each one wastes energy.",
  "version": "0.1.0",
  "publisher": "fabiocicerchia",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiocicerchia/greenlint.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/fabiocicerchia/greenlint",
  "bugs": {
    "url": "https://github.com/fabiocicerchia/greenlint/issues"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "green software",
    "sustainability",
    "energy",
    "carbon",
    "linter"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onLanguage:csharp",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:php",
    "onLanguage:perl",
    "onLanguage:ruby",
    "onLanguage:shellscript",
    "onLanguage:sql",
    "onLanguage:yaml",
    "onLanguage:dockerfile",
    "onLanguage:terraform",
    "onLanguage:html",
    "onLanguage:css"
  ],
  "contributes": {
    "configuration": {
      "title": "greenlint",
      "properties": {
        "greenlint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable greenlint diagnostics."
        },
        "greenlint.run": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "manual"
          ],
          "enumDescriptions": [
            "Scan the buffer while you type, debounced.",
            "Scan when the file is saved.",
            "Scan only when you run a greenlint command."
          ],
          "default": "onType",
          "description": "When to scan the open file."
        },
        "greenlint.debounceMs": {
          "type": "integer",
          "default": 400,
          "minimum": 100,
          "maximum": 5000,
          "description": "Idle time before an onType scan runs. Higher means fewer scans; the cost of a keystroke is this timer being reset, not a scan."
        },
        "greenlint.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to run the scan server with. Empty means auto-detect (python3, python, then py -3)."
        },
        "greenlint.greenlintPath": {
          "type": "string",
          "default": "",
          "description": "Path to greenlint.py or the directory holding it. Empty means use the installed greenlint package, falling back to a greenlint.py in the workspace root."
        },
        "greenlint.scanProjectOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Scan the whole workspace once when the extension starts, so the Findings panel is populated before you open a file."
        },
        "greenlint.projectScanIntervalMinutes": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "description": "Rescan the workspace on this interval. 0 (the default) disables it: saves, creates and deletes already keep the results current, so a timer only re-reads files nothing has touched."
        },
        "greenlint.maxFileBytes": {
          "type": "integer",
          "default": 1000000,
          "minimum": 1024,
          "description": "Skip files larger than this. A generated or vendored megabyte costs real time to scan and is rarely yours to fix."
        },
        "greenlint.cacheEntries": {
          "type": "integer",
          "default": 4096,
          "minimum": 128,
          "description": "How many files the scan server keeps findings for. Roughly a kilobyte each; the oldest are dropped first."
        },
        "greenlint.severityLevels": {
          "type": "object",
          "default": {
            "high": "Warning",
            "medium": "Information",
            "low": "Hint"
          },
          "properties": {
            "high": {
              "type": "string",
              "enum": [
                "Error",
                "Warning",
                "Information",
                "Hint"
              ]
            },
            "medium": {
              "type": "string",
              "enum": [
                "Error",
                "Warning",
                "Information",
                "Hint"
              ]
            },
            "low": {
              "type": "string",
              "enum": [
                "Error",
                "Warning",
                "Information",
                "Hint"
              ]
            }
          },
          "additionalProperties": false,
          "description": "How greenlint severities map to editor squiggles."
        },
        "greenlint.showCo2eEstimate": {
          "type": "boolean",
          "default": true,
          "description": "Include the order-of-magnitude CO2e hint in hovers and the report."
        },
        "greenlint.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log every request, its timing and its cache outcome to the greenlint output channel."
        }
      }
    },
    "commands": [
      {
        "command": "greenlint.scanFile",
        "title": "Scan Current File",
        "category": "greenlint",
        "icon": "$(file)"
      },
      {
        "command": "greenlint.scanProject",
        "title": "Scan Workspace",
        "category": "greenlint",
        "icon": "$(refresh)"
      },
      {
        "command": "greenlint.showReport",
        "title": "Open Report",
        "category": "greenlint",
        "icon": "$(graph)"
      },
      {
        "command": "greenlint.exportReport",
        "title": "Export HTML Report",
        "category": "greenlint"
      },
      {
        "command": "greenlint.showScopeFile",
        "title": "Showing: Current File",
        "category": "greenlint",
        "icon": "$(file)"
      },
      {
        "command": "greenlint.showScopeProject",
        "title": "Showing: Whole Project",
        "category": "greenlint",
        "icon": "$(folder-opened)"
      },
      {
        "command": "greenlint.setGrouping",
        "title": "Group Findings By...",
        "category": "greenlint",
        "icon": "$(list-tree)"
      },
      {
        "command": "greenlint.setSeverityFilter",
        "title": "Filter by Severity...",
        "category": "greenlint",
        "icon": "$(filter)"
      },
      {
        "command": "greenlint.disableRule",
        "title": "Disable Rule in .greenlint.toml",
        "category": "greenlint"
      },
      {
        "command": "greenlint.clearCache",
        "title": "Clear Cache and Rescan",
        "category": "greenlint"
      },
      {
        "command": "greenlint.showOutput",
        "title": "Show Log",
        "category": "greenlint"
      },
      {
        "command": "greenlint.restartServer",
        "title": "Restart Scan Server",
        "category": "greenlint"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "greenlint",
          "title": "greenlint",
          "icon": "media/leaf.svg"
        }
      ]
    },
    "views": {
      "greenlint": [
        {
          "id": "greenlint.findings",
          "name": "Findings",
          "icon": "media/leaf.svg",
          "contextualTitle": "greenlint"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "greenlint.findings",
        "contents": "No findings yet.\n[Scan Workspace](command:greenlint.scanProject)\nOr open a file and start typing — greenlint scans the buffer as you go.",
        "when": "!greenlint.hasFindings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "greenlint.showScopeProject",
          "when": "view == greenlint.findings && greenlint.scope == file",
          "group": "navigation@1"
        },
        {
          "command": "greenlint.showScopeFile",
          "when": "view == greenlint.findings && greenlint.scope == project",
          "group": "navigation@1"
        },
        {
          "command": "greenlint.setSeverityFilter",
          "when": "view == greenlint.findings",
          "group": "navigation@2"
        },
        {
          "command": "greenlint.setGrouping",
          "when": "view == greenlint.findings",
          "group": "navigation@3"
        },
        {
          "command": "greenlint.scanProject",
          "when": "view == greenlint.findings",
          "group": "navigation@4"
        },
        {
          "command": "greenlint.showReport",
          "when": "view == greenlint.findings",
          "group": "navigation@5"
        },
        {
          "command": "greenlint.exportReport",
          "when": "view == greenlint.findings",
          "group": "1_report"
        },
        {
          "command": "greenlint.clearCache",
          "when": "view == greenlint.findings",
          "group": "9_admin"
        },
        {
          "command": "greenlint.showOutput",
          "when": "view == greenlint.findings",
          "group": "9_admin"
        }
      ],
      "commandPalette": [
        {
          "command": "greenlint.showScopeFile",
          "when": "false"
        },
        {
          "command": "greenlint.showScopeProject",
          "when": "false"
        },
        {
          "command": "greenlint.disableRule",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
